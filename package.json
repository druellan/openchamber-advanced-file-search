{
  "name": "openchamber-advanced-file-search",
  "version": "1.1.0",
  "private": true,
  "description": "Advanced file content search extension for OpenChamber — search all or some files for a string or regex",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "id": "file-search",
    "name": "Advanced File Search",
    "icon": "search",
    "contributes": {
      "panel": {
        "entry": "panel/index.html"
      },
      "capabilities": [
        "files"
      ]
    }
  },
  "scripts": {
    "build": "esbuild panel/main.ts --bundle --platform=browser --format=iife --outfile=panel/main.js --minify"
  },
  "devDependencies": {
    "@openchamber/sdk": "^1.24.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
